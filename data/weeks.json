      "path": "weekly/2026-07-21/index.html",
      "theme": "AI-Native at Scale",
      "quote": "The bolt-on AI era is ending. AI-native learning architecture is now generally available — and new data shows what happens when AI adoption races ahead of understanding.",
      "tags": ["AI-Native LMS", "Workday", "Sana", "Learning Debt", "Shadow Competence", "Enterprise Governance", "Skill Gaps", "Content Creation", "Learning Architecture", "Measurement", "Onboarding"],
      "companies": ["Workday", "Sana", "Josh Bersin Company", "Accenture", "TalentLMS", "Epignosis", "Go1", "Synthesia"],
      "publishedAt": "2026-07-26",
      "roles": ["Artificial Intelligence Engineer", "Artificial Intelligence Consultant", "Artificial Intelligence Researcher", "Workforce Development Manager", "Learning Specialist", "Big Data Specialist", "Platform Engineer", "Human Resources Onboarding Specialist"],
      "tools": ["Workday Learning", "Sana", "TalentLMS", "Go1", "Synthesia"],
      "methods": [
        { "text": "Add 'explain the core logic of your most significant change' to code review template to surface learning debt before it accumulates", "source": "TalentLMS Learning Debt Report, Jul 2026", "sourceUrl": "https://www.prnewswire.com/news-releases/talentlms-learning-debt-report-ai-use-may-be-masking-skill-gaps-302825216.html" },
        { "text": "Run a 5-question AI tool census to map what tools are actually in use before designing any AI training program", "source": "Go1 survey — 80% of IT leaders found shadow AI tools; Lemonade Angle", "sourceUrl": "https://www.prnewswire.com/news-releases/confidence-in-ld-is-rising-but-ai-is-making-learning-tech-an-enterprise-decision-302795909.html" },
        { "text": "During L&D platform evaluation, require a live demo showing AI layer connected to real employee data — not a slideshow, a running instance", "source": "Workday/Sana GA analysis; Lemonade Angle", "sourceUrl": "https://www.prnewswire.com/news-releases/workday-learning-powered-by-sana-now-generally-available-as-an-ai-native-learning-experience-built-on-workdays-trusted-data-302831592.html" }
      ],
      "doThis": [
        "Run a learning debt audit — add an 'explain the logic' field to code review to surface hidden skill gaps before they cause mistakes",
        "Map what AI tools are actually in use before designing any training — the gap between licensed and actually used is your real curriculum",
        "Evaluate AI learning platforms by asking if the AI is foundational (connected to real HR data) or cosmetic (a 'generate with AI' button)"
      ],
      "avoidThis": [
        "Don't measure AI adoption by completion rates alone — 59% use AI for tasks they were never trained for, invisible in any LMS report",
        "Don't leave AI upskilling to self-discovery — learning debt accumulates when AI appearance substitutes for real understanding",
        "Don't buy an LMS based on AI feature marketing — ask whether its intelligence layer connects to your actual workforce and skills data"
      ],
