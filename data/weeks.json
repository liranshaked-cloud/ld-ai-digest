      "path": "weekly/2026-07-14/index.html",
      "theme": "The Reshape Imperative",
      "quote": "AI is reshaping jobs faster than companies are redesigning work. That gap is L&D's mandate — not optional upskilling, but urgent role reinvention.",
      "tags": ["Job Reshaping", "Workflow Redesign", "Collective AI", "Frontline AI", "Skills Gap", "Amazon Upskilling", "Review Bottleneck", "Human Skills", "BCG", "Bright Horizons", "LinkedIn"],
      "companies": ["Amazon", "Faros AI", "BCG", "Bright Horizons", "LinkedIn"],
      "publishedAt": "2026-07-20",
      "roles": ["Artificial Intelligence Engineer", "Artificial Intelligence Consultant", "Artificial Intelligence Researcher", "Workforce Development Manager", "Big Data Specialist", "Security Management Specialist", "Human Resources Onboarding Specialist"],
      "tools": ["Faros AI", "GitHub Copilot", "Amazon Career Choice", "AWS Skill Builder"],
      "methods": [
        { "text": "Map one squad's AI usage and identify the human judgment bottleneck, then redesign that single step rather than the whole workflow", "source": "BCG 'AI Is Reshaping Jobs Faster' survey, Jun 2026", "sourceUrl": "https://www.prnewswire.com/news-releases/ai-is-reshaping-jobs-faster-than-companies-are-reshaping-work-302789481.html" },
        { "text": "Create explicit AI review triage criteria (which code gets fast-tracked vs. deep review) as a teachable, transferable standard", "source": "Faros AI productivity analysis — 91% longer review time", "sourceUrl": "https://www.faros.ai/blog/lab-vs-reality-ai-productivity-study-findings" },
        { "text": "Replace 'use AI however works for you' with a 3-item AI practice minimum (one prompt pattern, one anti-pattern, one review habit) embedded in onboarding — not a course, a standard", "source": "Lemonade Angle, Bright Horizons 42% self-teach gap", "sourceUrl": "https://investors.brighthorizons.com/news-releases/news-release-details/2026-workforce-outlook-employers-prioritize-ai-literacy-and" }
      ],
      "doThis": [
        "Design for team-level workflow redesign, not just individual AI access — BCG finds 25pp higher business impact with clear AI strategy vs. tools alone",
        "Create a review triage standard so AI adoption doesn't just shift the constraint to senior engineer review queues",
        "Embed a structured minimum AI practice standard in onboarding from week one — not optional, not a course"
      ],
      "avoidThis": [
        "Don't measure only AI task volume — also track cycle time and bottleneck location (the 91% review time finding is the tell)",
        "Don't let 'figure it out yourself' be your AI upskilling strategy — 42% of workers are already experiencing this gap",
        "Don't focus only on individual productivity — BCG's data shows collective workflow redesign is what drives business outcomes, not individual tool access"
      ],
